# Copier ce fichier en .env (jamais commité) puis remplir les valeurs.
# Clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Webhook GitHub (Settings > Webhooks > Secret) : même valeur des deux côtés
GITHUB_WEBHOOK_SECRET=
# Jeton partagé entre n8n et Django (en-tête X-Sync-Token)
N8N_SYNC_TOKEN=
# Facultatif : webhook n8n prévenu à la fin de chaque exécution
# (workflow n8n/run_report_workflow.json), par exemple :
# N8N_RUN_WEBHOOK_URL=http://localhost:5678/webhook/copilot-run
N8N_RUN_WEBHOOK_URL=
# 1 : faire « git pull --ff-only » avant de réindexer
SYNC_GIT_PULL=0
SYNC_BRANCH=main

TOKEN_BUDGET=6000
