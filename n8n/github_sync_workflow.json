{
  "name": "GitHub -> Django : resynchroniser le registre",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-sync",
        "responseMode": "responseNode",
        "options": { "rawBody": true }
      },
      "name": "Webhook GitHub",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "github-sync"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/sync/n8n/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Sync-Token", "value": "={{ $env.N8N_SYNC_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Hub-Signature-256", "value": "={{ $json.headers['x-hub-signature-256'] || '' }}" },
            { "name": "X-GitHub-Event", "value": "={{ $json.headers['x-github-event'] || '' }}" },
            { "name": "X-GitHub-Delivery", "value": "={{ $json.headers['x-github-delivery'] || '' }}" }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      },
      "name": "Relayer le corps brut à Django (signature vérifiée par Django)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.body) }}",
        "options": { "responseCode": "={{ $json.statusCode }}" }
      },
      "name": "Répondre à GitHub avec le statut de Django",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Webhook GitHub": {
      "main": [[{ "node": "Relayer le corps brut à Django (signature vérifiée par Django)", "type": "main", "index": 0 }]]
    },
    "Relayer le corps brut à Django (signature vérifiée par Django)": {
      "main": [[{ "node": "Répondre à GitHub avec le statut de Django", "type": "main", "index": 0 }]]
    }
  },
  "settings": {}
}
